{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "BearCAM simulator job file, version 1",
  "type": "object",
  "required": ["format", "version", "nc", "stock", "tools"],
  "properties": {
    "format": {"const": "bearcam-sim-job"},
    "version": {"const": 1},
    "name": {"type": "string"},
    "nc": {"type": "string"},
    "units": {"enum": ["mm", "inch"]},
    "rapid_mm_min": {"type": "number", "exclusiveMinimum": 0},
    "stock": {
      "oneOf": [
        {"type": "object", "required": ["kind", "min", "max"],
         "properties": {"kind": {"const": "box"}, "min": {"$ref": "#/$defs/xyz"}, "max": {"$ref": "#/$defs/xyz"}}},
        {"type": "object", "required": ["kind", "z", "radius"],
         "properties": {"kind": {"const": "cylinder"}, "axis": {"const": "z"}, "center": {"$ref": "#/$defs/xy"},
                        "z": {"$ref": "#/$defs/xy"}, "radius": {"type": "number", "exclusiveMinimum": 0}}},
        {"type": "object", "required": ["kind", "x", "radius"],
         "properties": {"kind": {"const": "bar"}, "axis": {"const": "x"}, "center": {"$ref": "#/$defs/xy"},
                        "x": {"$ref": "#/$defs/xy"}, "radius": {"type": "number", "exclusiveMinimum": 0}}},
        {"type": "object", "required": ["kind", "profile"],
         "properties": {"kind": {"const": "revolved"}, "axis": {"const": "z"}, "center": {"$ref": "#/$defs/xy"},
                        "profile": {"type": "array", "minItems": 3, "maxItems": 32, "items": {"$ref": "#/$defs/xy"}}}}
      ]
    },
    "tools": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["number", "kind", "diameter"],
        "properties": {
          "number": {"type": "integer", "minimum": 0},
          "kind": {"enum": ["flat", "ball", "bull", "chamfer", "vbit", "taperball", "tslot", "threadmill"]},
          "diameter": {"type": "number", "exclusiveMinimum": 0},
          "name": {"type": "string"},
          "flute_length": {"type": "number", "minimum": 0},
          "corner_radius": {"type": "number", "minimum": 0},
          "angle": {"type": "number", "exclusiveMinimum": 0, "exclusiveMaximum": 180},
          "tip_diameter": {"type": "number", "minimum": 0},
          "height": {"type": "number", "exclusiveMinimum": 0},
          "crest": {"type": "number", "minimum": 0},
          "neck_diameter": {"type": "number", "exclusiveMinimum": 0},
          "neck_length": {"type": "number", "minimum": 0},
          "shank_diameter": {"type": "number", "minimum": 0},
          "cone": {"type": "number", "minimum": 0}
        }
      }
    },
    "work_offset": {"type": "object", "properties": {"name": {"type": "string"}, "origin": {"$ref": "#/$defs/xyz"}}},
    "rotary": {"oneOf": [{"type": "null"}, {"type": "object", "properties": {"axis": {"const": "A"}, "a_sign": {"enum": [-1, 1]}}}]},
    "machine": {"type": "object"},
    "operations": {
      "type": "array",
      "items": {"type": "object", "required": ["name"],
                "properties": {"name": {"type": "string"}, "first_line": {"type": "integer", "minimum": 0},
                               "tool": {"type": "integer"}}}
    },
    "engine": {"enum": ["hf", "rhf", "vol"]},
    "voxel": {"type": "number", "exclusiveMinimum": 0},
    "source": {"type": "object"}
  },
  "$defs": {
    "xy": {"type": "array", "items": {"type": "number"}, "minItems": 2, "maxItems": 2},
    "xyz": {"type": "array", "items": {"type": "number"}, "minItems": 3, "maxItems": 3}
  }
}
