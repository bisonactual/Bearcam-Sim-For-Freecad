<?xml version="1.0" encoding="UTF-8" standalone="no" ?>
<package format="1" xmlns="https://wiki.freecad.org/Package_Metadata">
  <name>BearCAM Simulator</name>
  <description>FreeCAD G-code simulator, by BearCAM: plays a CAM job's posted G-code in the BearCAM stock simulator (its own window), with real-time speed steps, a DRO, the G-code beside it and the operations on the timeline. Windows and Linux.</description>
  <version>0.6.0</version>
  <date>2026-10-28</date>
  <!-- To set: the maintainer's address. The simulator program (release files) is under
       LICENSE-SIMULATOR.txt, not MIT. -->
  <maintainer email="">BearCAM</maintainer>
  <license file="LICENSE">MIT</license>
  <url type="repository" branch="main">https://github.com/bisonactual/Bearcam-Sim-For-Freecad</url>
  <icon>Resources/icons/BearCAMSimulate.png</icon>
  <freecadmin>1.0.0</freecadmin>
  <!-- A workbench item without a class: the add-on adds commands to CAM and has no workbench of
       its own. FreeCAD 1.0 and 1.1 run InitGui.py only for workbench items, so as "other" content
       its commands never appeared there; 1.2 and 26.3 run it either way. The Addon Manager (1.1,
       1.2) takes the add-on's own name when there is no class, marks the install "restart
       required", and disables it by its ADDON_DISABLED stop file. -->
  <content>
    <workbench>
      <name>BearCAM Simulator</name>
      <subdirectory>./</subdirectory>
      <tag>CAM</tag>
      <tag>simulation</tag>
      <tag>G-code</tag>
    </workbench>
  </content>
</package>
